def format_rupiah(angka):
    return 'Rp' + f'{angka:,}'.replace(',', '.')

def tanya_yn(pesan):
    while True:
        jawab = input(pesan + ' (y/n): ').strip().lower()
        if jawab == 'y':
            return True
        elif jawab == 'n':
            return False
        print('Pilih y atau n.')
